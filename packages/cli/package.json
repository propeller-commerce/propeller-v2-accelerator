{
  "name": "@propeller-commerce/create-propeller-shop",
  "version": "0.9.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "Scaffold a new Propeller Commerce shop in minutes. Templates + prompts + version pinning.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "create-propeller-shop": "./dist/bin/create-propeller-shop.js",
    "propeller": "./dist/bin/propeller.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:templates": "node scripts/copy-templates.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const{rmSync}=require('fs');for(const d of ['dist','templates'])rmSync(d,{recursive:true,force:true})\"",
    "prepublishOnly": "node ../../scripts/check-textpatches.mjs && npm run build:templates && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.0",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "ora": "^8.1.0",
    "semver": "^7.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20",
    "@types/semver": "^7.5.8",
    "tsup": "^8.3.5",
    "typescript": "~5.9"
  },
  "engines": {
    "node": ">=18"
  }
}
