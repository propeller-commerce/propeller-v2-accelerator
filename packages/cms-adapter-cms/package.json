{
  "name": "propeller-v2-cms-adapter-cms",
  "version": "0.2.0",
  "description": "Stub CmsProvider for the generic 'Propeller CMS' backend. Returns null/empty for all methods — exercises the full provider contract without blocking on backend availability.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue\""
  },
  "peerDependencies": {
    "@propeller-commerce/propeller-v2-core-ui": "^0.3.0"
  },
  "devDependencies": {
    "@propeller-commerce/propeller-sdk-v2": "^0.12.0",
    "@propeller-commerce/propeller-v2-core-ui": "^0.3.0",
    "@types/node": "^20",
    "tsup": "^8.3.5",
    "typescript": "~5.9"
  },
  "sideEffects": false
}
